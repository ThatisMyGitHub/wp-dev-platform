#!/usr/bin/env bash
set -euo pipefail

FAIL=0
SMOKE_FILE=""

pass() { printf 'PASS  %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*" >&2; FAIL=1; }

cleanup() {
  if [[ -n "$SMOKE_FILE" ]]; then
    rm -f "/var/www/html/$SMOKE_FILE" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT HUP INT TERM

: "${WORDPRESS_DB_HOST:?WORDPRESS_DB_HOST is required}"
: "${WORDPRESS_DB_NAME:?WORDPRESS_DB_NAME is required}"
: "${WORDPRESS_DB_USER:?WORDPRESS_DB_USER is required}"
: "${WORDPRESS_DB_PASSWORD:?WORDPRESS_DB_PASSWORD is required}"

PHP_VERSION_ACTUAL="$(php -r 'echo PHP_VERSION;' 2>/dev/null || true)"
[[ "$PHP_VERSION_ACTUAL" == 8.3.* ]] && pass "PHP CLI/runtime family is $PHP_VERSION_ACTUAL (expected 8.3.x)" || fail "PHP runtime is '$PHP_VERSION_ACTUAL' (expected 8.3.x)"

# PHP deliberately reports max_execution_time=0 under CLI even when the web/FPM
# runtime is configured to 120 seconds. Verify CLI-compatible settings here and
# verify the authoritative web value through Apache/FastCGI below.
CLI_LIMITS="$(php -r 'echo ini_get("memory_limit"),"|",ini_get("max_execution_time"),"|",ini_get("max_input_time"),"|",ini_get("max_input_vars"),"|",ini_get("post_max_size"),"|",ini_get("upload_max_filesize"),"|",ini_get("max_file_uploads"),"|",ini_get("default_socket_timeout"),"|",ini_get("opcache.enable");' 2>/dev/null || true)"
[[ "$CLI_LIMITS" == '128M|0|-1|3000|512M|512M|20|60|1' ]] && pass "PHP CLI settings reflect the RC1 baseline and CLI timeout semantics" || fail "PHP CLI settings mismatch: $CLI_LIMITS"

PHP_MODULES="$(php -m 2>/dev/null || true)"
REQUIRED_MODULES=(
  bcmath bz2 calendar curl dom exif fileinfo ftp gd gettext imagick intl mbstring
  mysqli mysqlnd pcntl PDO pdo_mysql pdo_sqlite SimpleXML soap sockets sodium sqlite3
  xml xmlreader xmlwriter xsl zip "Zend OPcache"
)
MISSING_MODULES=()
for module in "${REQUIRED_MODULES[@]}"; do
  if ! grep -Fxq "$module" <<<"$PHP_MODULES"; then
    MISSING_MODULES+=("$module")
  fi
done
if (( ${#MISSING_MODULES[@]} == 0 )); then
  pass "DreamHost-compatible PHP extension baseline is present"
else
  fail "Missing PHP modules: ${MISSING_MODULES[*]}"
fi

# Query MySQL through mysqli rather than a distro command-line client. This is
# the same PHP/MySQL client path WordPress uses and avoids false failures caused
# by MariaDB/MySQL CLI authentication-plugin differences.
DB_DIAG="$(php <<'PHP' 2>/dev/null || true
<?php
mysqli_report(MYSQLI_REPORT_OFF);

$hostSpec = getenv('WORDPRESS_DB_HOST') ?: 'db:3306';
$host = $hostSpec;
$port = 3306;

if (preg_match('/^(.+):(\d+)$/', $hostSpec, $matches)) {
    $host = $matches[1];
    $port = (int) $matches[2];
}

$db = mysqli_init();
if (!$db || !@mysqli_real_connect(
    $db,
    $host,
    getenv('WORDPRESS_DB_USER'),
    getenv('WORDPRESS_DB_PASSWORD'),
    getenv('WORDPRESS_DB_NAME'),
    $port
)) {
    exit(2);
}

$version = $db->query('SELECT VERSION()')->fetch_row()[0];
$settings = $db->query(
    "SELECT CONCAT(@@sql_mode,'|',@@max_allowed_packet,'|',@@lower_case_table_names,'|',@@character_set_server,'|',@@collation_server,'|',@@default_storage_engine)"
)->fetch_row()[0];

$grantResult = $db->query('SHOW GRANTS FOR CURRENT_USER()');
$grants = [];
while ($row = $grantResult->fetch_row()) {
    $grants[] = $row[0];
}

echo 'VERSION=', $version, PHP_EOL;
echo 'SETTINGS=', $settings, PHP_EOL;
foreach ($grants as $grant) {
    echo 'GRANT=', $grant, PHP_EOL;
}
PHP
)"

DB_VERSION="$(sed -n 's/^VERSION=//p' <<<"$DB_DIAG" | head -n 1)"
DB_SETTINGS="$(sed -n 's/^SETTINGS=//p' <<<"$DB_DIAG" | head -n 1)"
GRANTS="$(sed -n 's/^GRANT=//p' <<<"$DB_DIAG")"

[[ "$DB_VERSION" == 8.0.41* ]] && pass "MySQL runtime is $DB_VERSION" || fail "MySQL runtime is '$DB_VERSION' (expected 8.0.41.x)"

[[ "$DB_SETTINGS" == 'NO_ENGINE_SUBSTITUTION|33554432|0|utf8mb4|utf8mb4_unicode_520_ci|InnoDB' ]] && pass "DreamHost SQL settings and clean reusable schema defaults are applied" || fail "Database settings mismatch: $DB_SETTINGS"

if grep -q 'TRIGGER' <<<"$GRANTS" && grep -q 'CREATE ROUTINE' <<<"$GRANTS" && ! grep -Eq '(^|[, ])EVENT([, ]|$)' <<<"$GRANTS" && ! grep -q 'GRANT OPTION' <<<"$GRANTS"; then
  pass "Application grants match the measured DreamHost privilege envelope"
else
  fail "Application grants do not match the intended DreamHost privilege model"
fi

if wp --allow-root core is-installed >/dev/null 2>&1; then
  pass "WordPress is installed"
else
  fail "WordPress is not installed; complete installation before running the full doctor"
fi

WP_RUNTIME="$(wp --allow-root eval 'global $wpdb; echo $wpdb->charset,"|",$wpdb->collate;' 2>/dev/null || true)"
[[ "$WP_RUNTIME" == 'utf8mb4|utf8mb4_unicode_520_ci' ]] && pass "WordPress DB connection is utf8mb4 / unicode_520" || fail "WordPress DB connection mismatch: $WP_RUNTIME"

# WordPress core/plugin/theme maintenance requires outbound HTTPS. Test through
# WordPress's own HTTP API so DNS, routing, CA validation and the application
# transport layer are all exercised together.
WPORG_STATUS="$(wp --allow-root eval '
$r = wp_remote_get("https://api.wordpress.org/core/version-check/1.7/", ["timeout" => 15]);
if (is_wp_error($r)) { echo "ERROR:" . $r->get_error_message(); exit; }
echo wp_remote_retrieve_response_code($r);
' 2>/dev/null || true)"
[[ "$WPORG_STATUS" == '200' ]] && pass "WordPress outbound HTTPS to api.wordpress.org is functional" || fail "WordPress.org HTTPS check failed: $WPORG_STATUS"

# Exercise the actual development web boundary and measure the settings as PHP
# sees them under FPM/FastCGI, rather than inferring them from CLI behavior.
SMOKE_FILE="wpdev-runtime-$RANDOM-$$.php"
cat > "/var/www/html/$SMOKE_FILE" <<'PHP'
<?php
header('Content-Type: text/plain; charset=UTF-8');
header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');

echo implode('|', [
    PHP_VERSION,
    PHP_SAPI,
    ini_get('memory_limit'),
    ini_get('max_execution_time'),
    ini_get('max_input_time'),
    ini_get('max_input_vars'),
    ini_get('post_max_size'),
    ini_get('upload_max_filesize'),
    ini_get('max_file_uploads'),
    ini_get('default_socket_timeout'),
    ini_get('opcache.enable'),
]);
PHP

WEB_RUNTIME="$(php -r '$ctx=stream_context_create(["http"=>["timeout"=>5]]); $v=@file_get_contents("http://web/'"$SMOKE_FILE"'", false, $ctx); if ($v === false) { exit(1); } echo trim($v);' 2>/dev/null || true)"

if [[ "$WEB_RUNTIME" =~ ^8\.3\.[0-9]+\|fpm-fcgi\|128M\|120\|-1\|3000\|512M\|512M\|20\|60\|1$ ]]; then
  pass "Apache -> FastCGI -> PHP web runtime matches RC1 baseline ($WEB_RUNTIME)"
else
  fail "Apache/FastCGI web runtime mismatch: $WEB_RUNTIME"
fi

cleanup
SMOKE_FILE=""
trap - EXIT HUP INT TERM

if (( FAIL )); then
  echo "wp-dev-platform doctor detected compatibility failures." >&2
  exit 1
fi

echo "wp-dev-platform DreamHost Shared compatibility doctor passed."
