# wp-dev-platform / dreamhost-shared
# Copy to .env and replace all CHANGE_ME values before deployment.

WPDEV_PROJECT_SLUG=wpdev
TZ=UTC

# Public development URL reached through Cloudflare Tunnel.
WP_URL=https://dev.example.com
WP_ENVIRONMENT=development
WP_DEBUG=true
WP_TABLE_PREFIX=wp_
WP_POST_REVISIONS=10
WP_MEMORY_LIMIT=128M
WP_MAX_MEMORY_LIMIT=128M

# External Cloudflare network already present on Carida/QNAP.
CLOUDFLARE_NETWORK=carida_cloudflare
CLOUDFLARE_ALIAS=wpdev-web
ADMINER_ALIAS=wpdev-adminer

# RC1 deployment images. Portainer/QNAP consumes these prebuilt/validated images
# through compose.yaml and does not compile native PHP extensions on the NAS.
WORDPRESS_RUNTIME_IMAGE=ghcr.io/thatismygithub/wp-dev-platform-wordpress:0.1.0-rc1
HTTPD_RUNTIME_IMAGE=ghcr.io/thatismygithub/wp-dev-platform-httpd:0.1.0-rc1
MYSQL_RUNTIME_IMAGE=ghcr.io/thatismygithub/wp-dev-platform-mysql:0.1.0-rc1
ADMINER_IMAGE=adminer:5.5.1

# Source-build inputs used only with compose.build.yaml (CI/developer builds).
WORDPRESS_BASE_IMAGE=wordpress:7.0.4-php8.3-fpm@sha256:48fd4f0fee04801b95245c39d6ad915491ef00c943c8c359b1ea552e1647a18e
HTTPD_BASE_IMAGE=httpd:2.4.68@sha256:2920ed8587277d6aa8ea785e143e970835057123dc7bf1199d102c60c80a73bb
MYSQL_BASE_IMAGE=mysql:8.0.41@sha256:bf577825b52ab281d6281fb281eabbfdc73507eda8f2c2745790251533ef0306
WP_CLI_VERSION=2.12.0
PHP_BUILD_JOBS=1

# Development-only database credentials. Never commit the real .env file.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD
